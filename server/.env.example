# 复制为 .env 并按需填写

# 私钥（与 tools/private-key.json 相同的 JWK，单行）。
# 开发期可留空：会自动回退读取 ../tools/private-key.json
PRIVATE_KEY_JWK=

# 支付渠道：mock（开发自测） | alipay | wechat
PAY_CHANNEL=mock

PORT=3000
# 服务器对外基础地址（拼接支付回调 URL 用）
PUBLIC_BASE_URL=http://localhost:3000

# ── 支付宝当面付（阶段 B：商户号下来后填）──
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ── 微信支付 Native v3（阶段 B：商户号下来后填）──
WX_APP_ID=
WX_MCH_ID=
WX_API_V3_KEY=
WX_SERIAL_NO=
WX_PRIVATE_KEY_PATH=
